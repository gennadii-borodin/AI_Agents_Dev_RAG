OPENAI_API_KEY=your_key
# URL OpenAI-совместимого API. Пустое значение = официальный endpoint OpenAI.
# Для кастомного провайдера укажите его base URL, например Ollama:
#   http://localhost:11434/v1
OPENAI_BASE_URL=
# Имена используемых моделей (пустое значение = стандартные для демо)
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=hybrid_rag_password
